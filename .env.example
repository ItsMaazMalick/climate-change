DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

CCKP_API_BASE="https://cckpapi.worldbank.org/cckp/v1"
CCKP_S3_BASE="https://wbg-cckp.s3.amazonaws.com"
OPEN_METEO_BASE="https://api.open-meteo.com/v1"

CLIMATE_STORE_MODE="auto"
CLIMATE_CACHE_DIR=".cache/climate"
CLIMATE_UPSTREAM_TIMEOUT_MS="20000"
RATE_LIMIT_PER_MINUTE="240"
NEXT_PUBLIC_APP_NAME="Climate Pakistan"
